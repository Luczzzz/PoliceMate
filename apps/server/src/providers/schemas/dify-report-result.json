{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ReportDraft",
  "definitions": {
    "ReportDraft": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/ReportStatus"
        },
        "headline": {
          "type": "string"
        },
        "participantBehaviorSummary": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportParticipantBehaviorSummary"
          },
          "maxItems": 6
        },
        "factLimitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportDraftModule"
          }
        },
        "documentTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "procedureCategory": {
                "$ref": "#/definitions/ProcedureCategory"
              },
              "stageId": {
                "$ref": "#/definitions/HandlingStageId"
              },
              "applicableRoles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "caseTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "taskId",
              "title",
              "description",
              "procedureCategory",
              "stageId",
              "applicableRoles",
              "caseTags"
            ],
            "additionalProperties": false
          },
          "maxItems": 5
        },
        "quickBrief": {
          "$ref": "#/definitions/ReportQuickBrief",
          "description": "研判速览（ADR-0011）。"
        }
      },
      "required": [
        "status",
        "headline",
        "participantBehaviorSummary",
        "factLimitations",
        "modules",
        "documentTasks"
      ],
      "additionalProperties": false,
      "description": "模型实际输出的报告草稿（ADR-0013）：只含判断性文字与标识。 展示标签、法条原文与元数据、文书固定字段、封装元数据由后端补全为 `ReportGenerationResult`。"
    },
    "ReportStatus": {
      "type": "string",
      "enum": [
        "complete",
        "insufficient_facts",
        "conflicting",
        "basis_unavailable",
        "generation_failed",
        "partial_failure"
      ]
    },
    "ReportParticipantBehaviorSummary": {
      "type": "object",
      "properties": {
        "participant": {
          "type": "string"
        },
        "behavior": {
          "type": "string"
        },
        "factIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "participant",
        "behavior",
        "factIds",
        "note"
      ],
      "additionalProperties": false
    },
    "ReportDraftModule": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ReportModuleId"
        },
        "status": {
          "$ref": "#/definitions/ReportModuleStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 6
        },
        "traceLinks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportDraftTraceLink"
          },
          "maxItems": 4
        },
        "failureReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "description": "批次内稳定项目 ID，用于临时标记；不写入事实或 Dify 请求。"
              },
              "text": {
                "type": "string"
              },
              "purpose": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceHint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "preservationRisk": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "priority": {
                "$ref": "#/definitions/EvidencePriority"
              },
              "holdingStatus": {
                "$ref": "#/definitions/EvidenceHoldingStatus"
              }
            },
            "required": [
              "itemId",
              "text",
              "purpose",
              "sourceHint",
              "preservationRisk",
              "priority",
              "holdingStatus"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        },
        "interviewItems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportInterviewPointItem"
          },
          "maxItems": 12
        }
      },
      "required": [
        "id",
        "status",
        "summary",
        "items",
        "traceLinks",
        "failureReason",
        "evidenceItems",
        "interviewItems"
      ],
      "additionalProperties": false
    },
    "ReportModuleId": {
      "type": "string",
      "enum": [
        "preliminary_qualification",
        "filing_conditions",
        "evidence_checklist",
        "interview_points",
        "enforcement_risks",
        "legal_basis_trace"
      ]
    },
    "ReportModuleStatus": {
      "type": "string",
      "enum": [
        "present",
        "not_applicable",
        "insufficient_facts",
        "basis_unavailable",
        "conflicting",
        "generation_failed"
      ]
    },
    "ReportDraftTraceLink": {
      "type": "object",
      "properties": {
        "factIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "condition": {
          "type": "string"
        },
        "conditionStatus": {
          "type": "string",
          "enum": [
            "satisfied",
            "not_satisfied",
            "unknown",
            "conflicting"
          ]
        },
        "judgment": {
          "type": "string"
        },
        "basisKind": {
          "type": "string",
          "enum": [
            "formal_basis",
            "practical_check"
          ]
        },
        "basis": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReportDraftBasis"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "basis",
        "basisKind",
        "condition",
        "conditionStatus",
        "factIds",
        "judgment"
      ],
      "additionalProperties": false
    },
    "ReportDraftBasis": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "article": {
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "article"
      ],
      "additionalProperties": false,
      "description": "草稿中的法条引用：只给法源与条号，其余字段由后端从受治理法源补全（ADR-0013）。"
    },
    "EvidencePriority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "证据核查清单的优先级；展示名称由后端目录提供。"
    },
    "EvidenceHoldingStatus": {
      "type": "string",
      "enum": [
        "held",
        "partial",
        "not_held",
        "unknown"
      ],
      "description": "证据当前掌握状态；这是报告结构化内容，不是临时标记。"
    },
    "ReportInterviewPointItem": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "询问对象角色的稳定 ID；展示名称由 `roleLabel` 提供。"
        },
        "roleLabel": {
          "type": "string"
        },
        "topic": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "itemId",
        "text",
        "role",
        "roleLabel",
        "topic"
      ],
      "additionalProperties": false,
      "description": "分角色询问要点中的一条结构化项目。"
    },
    "ProcedureCategory": {
      "type": "string",
      "enum": [
        "administrative",
        "criminal"
      ],
      "description": "程序类别。"
    },
    "HandlingStageId": {
      "type": "string",
      "enum": [
        "reception_acceptance",
        "investigation_evidence",
        "measures_approval",
        "notification_service",
        "decision_disposition",
        "execution_closure"
      ],
      "description": "第一版固定的六个办理阶段。顺序即展示顺序，不得增删或改变含义。"
    },
    "ReportQuickBrief": {
      "type": "object",
      "properties": {
        "bottomLine": {
          "type": "string"
        },
        "nextSteps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportNextStep"
          }
        },
        "branchCards": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportBranchCard"
          }
        }
      },
      "required": [
        "bottomLine",
        "nextSteps",
        "branchCards"
      ],
      "additionalProperties": false,
      "description": "研判速览（ADR-0011）：一句白话定性、3–5 条立即动作、至多 3 张走向卡片。 可选字段：旧版本报告没有该字段时前端回落到研判概览，不补造。"
    },
    "ReportNextStep": {
      "type": "object",
      "properties": {
        "plain": {
          "type": "string"
        },
        "legal": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetModule": {
          "$ref": "#/definitions/ReportModuleId",
          "description": "对应的报告模块；点击后跳转到该模块详情。"
        }
      },
      "required": [
        "plain",
        "legal",
        "targetModule"
      ],
      "additionalProperties": false,
      "description": "研判速览中的一条立即动作：白话主句在前，法律术语仅作注释（ADR-0011）。"
    },
    "ReportBranchCard": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "legal": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "condition",
        "outcome",
        "legal"
      ],
      "additionalProperties": false,
      "description": "“如果…则…”走向卡片：左侧白话条件，右侧走向，法律名称作小字注释。"
    }
  }
}
