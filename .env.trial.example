# 受控试行部署配置示例（不包含任何真实主体信息）。
#
# 使用与数据说明中的服务主体、试行联系人、数据处理说明与技术日志边界必须由
# 试行组织者在发布前填写实际内容；未填写时页面如实显示“尚未配置”，
# `npm run release:acceptance` 会阻断受控试行发布（产品规格 11.5、18.1）。
#
# 复制为部署环境变量后填写实际值。任何一项为空、仍为占位值或包含
# “待填写 / 示例公司 / placeholder / TODO”等字样时发布检查都会失败。

# 实际服务提供者（部署与运维该 H5 与后端的主体）。
PM_SERVICE_PROVIDER=

# 受控试行反馈联系人（真实可用的联系渠道）。
PM_SERVICE_CONTACT=

# 适用的数据处理说明（内容会发送至模型服务处理，以及第三方服务的处理边界）。
PM_DATA_PROCESSING_STATEMENT=

# 技术日志边界；多行可使用 \n 或换行分隔。
PM_TECHNICAL_LOGGING_BOUNDARY=

# 生产式部署必须使用 HTTPS 且关闭测试替身控制。
# 真实分析：PM_PROVIDER_MODE=llm 时不会回退 fixture，缺少地址、密钥或模型名即失败关闭。
PM_PROVIDER_MODE=llm
PM_ALLOWED_ORIGINS=
NODE_ENV=production
PM_ENABLE_TEST_CONTROLS=0
PM_LLM_BASE_URL=https://
PM_LLM_API_KEY=
PM_LLM_MODEL=
# 可选：报告上的版本标注与结构化输出方式。
# PM_LLM_WORKFLOW_VERSION=policymate-llm-v1.0.0
# PM_LLM_RESPONSE_FORMAT=json_schema
# 可选：生成预算、事故问答超时与重试总预算（ADR-0019）。
# PM_LLM_MAX_TOKENS_STREAM=8192
# PM_LLM_MAX_TOKENS_ACCIDENT=6144
# PM_ACCIDENT_TIMEOUT_MS=60000
# PM_ACCIDENT_TOTAL_BUDGET_MS=120000
# 建议开启：遥测逐行落盘，便于事后区分"首字慢"与"中途卡死"（仍只写白名单字段）。
# PM_TELEMETRY_SINK=stdout
